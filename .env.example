# Copy this file to `.env` (never commit the real `.env`).
NODE_ENV=production

# Where the SQLite database file lives (a Docker volume mounts this path so
# data survives rebuilds — see docker-compose.yml).
DATABASE_PATH=/app/data/akort.db

# Powers the admin panel's "AI ile oluştur" SEO-description button.
# Get one at https://console.anthropic.com — API Keys — Create Key.
ANTHROPIC_API_KEY=
