# Copy this file to `.env` (never commit the real `.env`) and fill in real values.
# These power the admin panel's (/admin) GitHub login — see oauth-server/server.mjs.

# From a GitHub OAuth App: https://github.com/settings/developers -> "New OAuth App"
#   Homepage URL:               https://www.akortmuhendislik.com
#   Authorization callback URL: https://www.akortmuhendislik.com/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The site's public URL (no trailing slash). Must match the OAuth App above.
PUBLIC_SITE_URL=https://www.akortmuhendislik.com
