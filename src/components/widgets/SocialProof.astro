---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { SocialProof as Props } from '~/types';

// A compact strip of trust signals: store ratings, review-site scores,
// user counts, certifications. Each item is a value, a label and an icon
// or small logo, optionally linked and with a star rating.

const {
  items = [],
  layout = 'strip',
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const badges = layout === 'badges';

// A plain, explicit column count per item count (rather than deriving it at
// runtime) so Tailwind's build-time class scanner can see these literal
// strings — a computed class like `sm:grid-cols-${n}` would get purged from
// the production build. Grid (not flex-wrap) means any item count lines up
// cleanly instead of the last item awkwardly wrapping onto its own row.
const gridColsBySize: Record<number, string> = {
  1: 'sm:grid-cols-1',
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-3',
  4: 'sm:grid-cols-4',
  5: 'sm:grid-cols-5',
  6: 'sm:grid-cols-6',
};
const gridColsClass = gridColsBySize[items.length] ?? 'sm:grid-cols-3';
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-6xl mx-auto !py-6 md:!py-8 ${classes?.container ?? ''}`}
  bg={bg}
>
  <ul
    class:list={[
      'list-none',
      badges
        ? 'flex flex-wrap justify-center gap-3'
        : ['grid grid-cols-1 divide-y divide-gray-200 dark:divide-slate-700 sm:divide-y-0 sm:divide-x', gridColsClass],
    ]}
  >
    {
      items.map(({ label, value, icon, image, href, rating, color }) => {
        const Item = href ? 'a' : 'div';
        return (
          <li class:list={badges ? '' : 'flex justify-center py-5 sm:py-0 sm:px-6 lg:px-10'}>
            <Item
              href={href}
              target={href ? '_blank' : undefined}
              rel={href ? 'noopener noreferrer' : undefined}
              class:list={[
                'flex items-center',
                badges
                  ? 'gap-2 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm shadow-sm dark:border-slate-700 dark:bg-slate-900'
                  : 'gap-3',
                href ? 'group' : '',
              ]}
            >
              {image ? (
                typeof image === 'string' ? (
                  <Fragment set:html={image} />
                ) : (
                  <Image
                    class="h-8 w-8 object-contain"
                    width={32}
                    height={32}
                    layout="fixed"
                    format="webp"
                    {...image}
                  />
                )
              ) : (
                icon && (
                  <Icon
                    name={icon}
                    class:list={['shrink-0', color || 'text-primary', badges ? 'h-5 w-5' : 'h-8 w-8']}
                  />
                )
              )}
              <span class:list={badges ? 'flex items-baseline gap-1.5' : 'text-left'}>
                <span
                  class:list={[
                    'font-bold leading-tight text-heading group-hover:text-primary',
                    badges ? 'text-sm' : 'block text-lg',
                  ]}
                >
                  {value}
                </span>
                {rating && (
                  <span class="flex gap-0.5 text-amber-400" aria-label={`${rating} out of 5 stars`}>
                    {Array.from({ length: 5 }).map((_, i) => (
                      <Icon name={i < Math.round(rating) ? 'tabler:star-filled' : 'tabler:star'} class="h-3.5 w-3.5" />
                    ))}
                  </span>
                )}
                {label && <span class:list={['text-sm text-muted', badges ? '' : 'block']}>{label}</span>}
              </span>
            </Item>
          </li>
        );
      })
    }
  </ul>
</WidgetWrapper>
