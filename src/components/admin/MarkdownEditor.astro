---
import { Icon } from 'astro-icon/components';

export interface Props {
  name: string;
  value?: string | null;
  rows?: number;
  id?: string;
}

const { name, value, rows = 12, id } = Astro.props;
const textareaId = id ?? `md-${name}`;

const buttons: Array<{ cmd: string; title: string; icon?: string; label?: string }> = [
  { cmd: 'h2', title: 'Başlık', label: 'H2' },
  { cmd: 'h3', title: 'Alt Başlık', label: 'H3' },
  { cmd: 'bold', title: 'Kalın', label: 'K' },
  { cmd: 'italic', title: 'İtalik', label: 'İ' },
  { cmd: 'link', title: 'Bağlantı Ekle', icon: 'tabler:link' },
  { cmd: 'image', title: 'Görsel Ekle', icon: 'tabler:photo' },
  { cmd: 'ul', title: 'Madde Listesi', icon: 'tabler:list' },
  { cmd: 'ol', title: 'Numaralı Liste', icon: 'tabler:list-numbers' },
  { cmd: 'quote', title: 'Alıntı', icon: 'tabler:blockquote' },
  { cmd: 'code', title: 'Satır İçi Kod', icon: 'tabler:code' },
];
---

<aw-md-editor>
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
    <div class="btn-toolbar" role="toolbar" aria-label="Biçimlendirme araç çubuğu" data-md-toolbar>
      <div class="btn-group btn-group-sm">
        {
          buttons.map((b) => (
            <button type="button" class="btn btn-outline-secondary" data-md-cmd={b.cmd} title={b.title}>
              {b.icon ? <Icon name={b.icon} class="w-4 h-4" /> : <span class="fw-bold">{b.label}</span>}
            </button>
          ))
        }
      </div>
    </div>
    <div class="btn-group btn-group-sm" role="group" aria-label="Görünüm">
      <button type="button" class="btn btn-outline-primary active" data-md-view="text">Yazı</button>
      <button type="button" class="btn btn-outline-primary" data-md-view="preview">Önizleme</button>
    </div>
  </div>
  <textarea id={textareaId} name={name} class="form-control font-monospace" rows={rows} data-md-textarea
    >{value}</textarea
  >
  <div class="form-control md-preview-pane d-none" data-md-preview></div>
  <input type="file" accept="image/*" class="d-none" data-md-image-input />
  <div class="text-danger small mt-1 d-none" data-md-image-error></div>
</aw-md-editor>

<style>
  .md-preview-pane {
    min-height: 10rem;
    max-height: 32rem;
    overflow-y: auto;
  }
  .md-preview-pane :global(h2),
  .md-preview-pane :global(h3),
  .md-preview-pane :global(h4) {
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }
  .md-preview-pane :global(h2:first-child),
  .md-preview-pane :global(h3:first-child) {
    margin-top: 0;
  }
  .md-preview-pane :global(blockquote) {
    border-left: 3px solid var(--tblr-border-color, #dce1e7);
    margin: 0.5rem 0;
    padding: 0.25rem 0 0.25rem 0.75rem;
    color: var(--tblr-secondary, #626976);
  }
  .md-preview-pane :global(code) {
    background: var(--tblr-bg-surface-secondary, #f4f6fa);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
  }
  .md-preview-pane :global(p:last-child) {
    margin-bottom: 0;
  }
</style>

<script>
  import { marked } from 'marked';

  class AwMdEditor extends HTMLElement {
    connectedCallback() {
      const textarea = this.querySelector('[data-md-textarea]');
      const preview = this.querySelector('[data-md-preview]');
      const toolbar = this.querySelector<HTMLElement>('[data-md-toolbar]');
      const imageInput = this.querySelector('[data-md-image-input]');
      const imageError = this.querySelector<HTMLElement>('[data-md-image-error]');
      if (
        !(textarea instanceof HTMLTextAreaElement) ||
        !(preview instanceof HTMLElement) ||
        !(imageInput instanceof HTMLInputElement)
      )
        return;

      // File pickers steal focus/selection from the textarea while open, so
      // the cursor position has to be captured before opening it and reused
      // once the upload finishes.
      let savedSelection = { start: 0, end: 0 };

      this.querySelectorAll<HTMLButtonElement>('[data-md-cmd]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cmd = btn.dataset.mdCmd;
          if (!cmd) return;
          if (cmd === 'image') {
            savedSelection = { start: textarea.selectionStart, end: textarea.selectionEnd };
            imageInput.click();
            return;
          }
          this.applyCommand(textarea, cmd);
        });
      });

      imageInput.addEventListener('change', async () => {
        const file = imageInput.files?.[0];
        imageInput.value = '';
        if (!file) return;

        imageError?.classList.add('d-none');
        const formData = new FormData();
        formData.append('file', file);

        try {
          const res = await fetch('/admin/api/upload-image', { method: 'POST', body: formData });
          const data = await res.json();
          if (!res.ok || data.error) throw new Error(data.error || 'Yükleme başarısız oldu.');

          const alt = window.prompt('Görsel açıklaması (alt metin):', '') ?? '';
          const { start, end } = savedSelection;
          const value = textarea.value;
          const inserted = `![${alt}](${data.url})`;
          textarea.value = `${value.slice(0, start)}${inserted}${value.slice(end)}`;
          const cursor = start + inserted.length;
          textarea.setSelectionRange(cursor, cursor);
          textarea.focus();
          textarea.dispatchEvent(new Event('input', { bubbles: true }));
        } catch (err) {
          if (imageError) {
            imageError.textContent = err instanceof Error ? err.message : 'Bilinmeyen hata.';
            imageError.classList.remove('d-none');
          }
        }
      });

      this.querySelectorAll<HTMLButtonElement>('[data-md-view]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const view = btn.dataset.mdView;
          const showPreview = view === 'preview';
          this.querySelectorAll<HTMLButtonElement>('[data-md-view]').forEach((b) =>
            b.classList.toggle('active', b === btn)
          );
          if (showPreview) preview.innerHTML = (marked.parse(textarea.value, { async: false }) as string) || '';
          textarea.classList.toggle('d-none', showPreview);
          preview.classList.toggle('d-none', !showPreview);
          toolbar?.classList.toggle('d-none', showPreview);
        });
      });
    }

    applyCommand(textarea: HTMLTextAreaElement, cmd: string) {
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const value = textarea.value;
      const selected = value.slice(start, end);
      const before = value.slice(0, start);
      const after = value.slice(end);

      const wrap = (marker: string, placeholder: string) => {
        const text = selected || placeholder;
        textarea.value = `${before}${marker}${text}${marker}${after}`;
        const from = before.length + marker.length;
        textarea.setSelectionRange(from, from + text.length);
      };

      const linePrefix = (prefix: string, placeholder: string) => {
        const text = selected || placeholder;
        const lines = text
          .split('\n')
          .map((line) => `${prefix}${line}`)
          .join('\n');
        textarea.value = `${before}${lines}${after}`;
        textarea.setSelectionRange(before.length, before.length + lines.length);
      };

      switch (cmd) {
        case 'bold':
          wrap('**', 'kalın metin');
          break;
        case 'italic':
          wrap('_', 'italik metin');
          break;
        case 'h2':
          linePrefix('## ', 'Başlık');
          break;
        case 'h3':
          linePrefix('### ', 'Alt başlık');
          break;
        case 'quote':
          linePrefix('> ', 'Alıntı metni');
          break;
        case 'ul':
          linePrefix('- ', 'Liste öğesi');
          break;
        case 'ol':
          linePrefix('1. ', 'Liste öğesi');
          break;
        case 'code':
          wrap('`', 'kod');
          break;
        case 'link': {
          const url = window.prompt("Bağlantı URL'si:", 'https://');
          if (!url) return;
          const text = selected || 'bağlantı metni';
          const inserted = `[${text}](${url})`;
          textarea.value = `${before}${inserted}${after}`;
          textarea.setSelectionRange(before.length + 1, before.length + 1 + text.length);
          break;
        }
      }

      textarea.focus();
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
    }
  }
  if (!customElements.get('aw-md-editor')) customElements.define('aw-md-editor', AwMdEditor);
</script>
