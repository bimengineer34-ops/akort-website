---
import type { Form as Props } from '~/types';
import Button from '~/components/ui/Button.astro';

const { inputs, textarea, disclaimer, button = 'Contact us', description = '', action, method = 'post' } = Astro.props;

const hasFile = inputs?.some(({ type }) => type === 'file');
const fieldClass =
  'py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900';
---

<form
  data-aw-form
  action={action}
  method={action ? method : undefined}
  enctype={hasFile ? 'multipart/form-data' : undefined}
>
  {
    inputs &&
      inputs.map(
        ({
          type = 'text',
          name,
          label = '',
          autocomplete = 'on',
          placeholder = '',
          required,
          value,
          accept,
          options,
        }) =>
          name &&
          (type === 'hidden' ? (
            <input type="hidden" name={name} value={value} />
          ) : (
            <div class="mb-6">
              {label && (
                <label for={name} class="block text-sm font-medium">
                  {label}
                  {required && <span aria-hidden="true"> *</span>}
                </label>
              )}
              {options ? (
                <select id={name} name={name} required={required} class={fieldClass}>
                  <option value="" disabled selected={!value}>
                    {placeholder || '—'}
                  </option>
                  {options.map((opt) => (
                    <option value={opt.value} selected={opt.value === value}>
                      {opt.label}
                    </option>
                  ))}
                </select>
              ) : (
                <input
                  type={type}
                  name={name}
                  id={name}
                  autocomplete={autocomplete}
                  placeholder={placeholder}
                  required={required}
                  value={type !== 'file' ? value : undefined}
                  accept={accept}
                  class={fieldClass}
                />
              )}
            </div>
          ))
      )
  }

  {
    textarea && (
      <div>
        <label for="textarea" class="block text-sm font-medium">
          {textarea.label}
        </label>
        <textarea
          id="textarea"
          name={textarea.name ? textarea.name : 'message'}
          rows={textarea.rows ? textarea.rows : 4}
          placeholder={textarea.placeholder}
          class="py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
        />
      </div>
    )
  }

  {
    disclaimer && (
      <div class="mt-3 flex items-start">
        <div class="flex mt-0.5">
          <input
            id="disclaimer"
            name="disclaimer"
            type="checkbox"
            class="cursor-pointer mt-1 py-3 px-4 block w-full text-md rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900"
          />
        </div>
        <div class="ml-3">
          <label for="disclaimer" class="cursor-pointer select-none text-sm text-gray-600 dark:text-gray-400">
            {disclaimer.label}
          </label>
        </div>
      </div>
    )
  }

  {
    button && (
      <div class="mt-10 grid">
        <Button variant="primary" type="submit">
          {button}
        </Button>
      </div>
    )
  }

  {
    description && (
      <div class="mt-3 text-center">
        <p class="text-sm text-gray-600 dark:text-gray-400">{description}</p>
      </div>
    )
  }
</form>

<script>
  // This is a plain full-page POST (no fetch/AJAX), so the only thing to do
  // client-side is signal "submitting" and block a double-click — the actual
  // success/error feedback comes back as a fresh page with a `?sent=1`/`?error=1`
  // banner. Rebind after Astro's view-transition navigations too.
  function bindAwForms() {
    document.querySelectorAll<HTMLFormElement>('form[data-aw-form]:not([data-aw-bound])').forEach((form) => {
      form.dataset.awBound = 'true';
      form.addEventListener('submit', () => {
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (!btn || btn.disabled) return;
        btn.dataset.originalText = btn.textContent ?? '';
        btn.textContent = 'Gönderiliyor…';
        btn.disabled = true;
        btn.classList.add('opacity-70', 'cursor-not-allowed');
      });
    });
  }
  bindAwForms();
  document.addEventListener('astro:page-load', bindAwForms);
</script>
