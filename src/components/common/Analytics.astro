---
import { ANALYTICS } from 'astrowind:config';
import { getSiteSettings } from '~/lib/siteSettings';

const siteSettings = getSiteSettings();

const dbId = siteSettings?.googleAnalyticsId;
const id = dbId || (ANALYTICS?.vendors?.googleAnalytics?.id ? String(ANALYTICS.vendors.googleAnalytics.id) : '');
const partytown = !!ANALYTICS?.vendors?.googleAnalytics?.partytown;
const scriptType = partytown ? 'text/partytown' : undefined;

const yandexId = siteSettings?.yandexMetricaId;
---

{id && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} type={scriptType} />}

<script is:inline id="ga-init" data-id={id} type={id ? scriptType : undefined}>
  if (document.getElementById('ga-init').dataset.id) {
    var d = document.getElementById('ga-init').dataset.id;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () {
      dataLayer.push(arguments);
    };
    window.gtag('js', new Date());
    window.gtag('config', d);
  }
</script>

<script is:inline id="ym-init" data-id={yandexId}>
  if (document.getElementById('ym-init').dataset.id) {
    (function (m, e, t, r, i, k, a) {
      m[i] =
        m[i] ||
        function () {
          (m[i].a = m[i].a || []).push(arguments);
        };
      m[i].l = 1 * new Date();
      for (var j = 0; j < document.scripts.length; j++) {
        if (document.scripts[j].src === r) return;
      }
      k = e.createElement(t);
      a = e.getElementsByTagName(t)[0];
      k.async = 1;
      k.src = r;
      a.parentNode.insertBefore(k, a);
    })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');
    var ymId = document.getElementById('ym-init').dataset.id;
    window.ym(Number(ymId), 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true });
  }
</script>
{
  yandexId && (
    <noscript>
      <div>
        <img
          src={`https://mc.yandex.ru/watch/${yandexId}`}
          style="position:absolute; left:-9999px;"
          alt=""
          referrerpolicy="unsafe-url"
        />
      </div>
    </noscript>
  )
}
