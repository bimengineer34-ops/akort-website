---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';

import { getHeaderData, getFooterData } from '~/navigation';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  /** Passed straight through to the default Header when the page doesn't
   * override the `header` slot — see Header's `solid` prop doc. */
  solidHeader?: boolean;
}

const { metadata, solidHeader = false } = Astro.props;
const headerData = getHeaderData();
const footerData = getFooterData();
---

<Layout metadata={metadata}>
  <slot name="head" slot="head" />
  {
    /*
    Slot fallbacks are rendered explicitly. With `<slot name="x">fallback</slot>`
    Astro still evaluates the fallback when the page overrides the slot, and
    astro-icon then believes the icons inside it (the RSS icon of the default
    header, for instance) were already emitted, so their SVG sprite symbol
    goes missing on that page.
  */
  }
  {Astro.slots.has('announcement') ? <slot name="announcement" /> : <Announcement />}
  {
    Astro.slots.has('header') ? (
      <slot name="header" />
    ) : (
      <Header {...headerData} isSticky showRssFeed showToggleTheme showSearch solid={solidHeader} />
    )
  }
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  {Astro.slots.has('footer') ? <slot name="footer" /> : <Footer {...footerData} />}
</Layout>
