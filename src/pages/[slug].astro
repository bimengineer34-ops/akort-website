---
import { eq } from 'drizzle-orm';
import { db } from '~/db/client';
import { pages } from '~/db/schema';
import { parseBodySections } from '~/lib/markdown';
import { getSiteSettings } from '~/lib/siteSettings';
import { getPermalink, getCanonical } from '~/utils/permalinks';
import { SITE } from 'astrowind:config';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';

export const prerender = false;

const page = db
  .select()
  .from(pages)
  .where(eq(pages.slug, Astro.params.slug ?? ''))
  .get();

if (!page) {
  return Astro.redirect('/404');
}

const metadata = { title: page.title, description: page.seoDescription ?? undefined };
const { introTitle, introHtml, sections } = parseBodySections(page.body);

// Only hizmet pages get a real, clickable middle crumb (Hizmetler ->
// /hizmetler); the hero's `tagline` eyebrow there already reads e.g.
// "Hizmetler / BIM & Dijital Mühendislik", so hideCurrent drops the trailing
// duplicate title from the visible trail (it stays in the ARIA text and
// JSON-LD). Other groups have no group landing page to link to, so they just
// show the plain two-level trail with the title visible — `hideCurrent` would
// wrongly hide a *middle*, non-linked "Kurumsal" crumb too (it hides every
// non-anchor item, not only the last one).
const groupCrumb = page.group === 'hizmet' ? { text: 'Hizmetler', href: getPermalink('/hizmetler') } : null;
const breadcrumbItems = [
  { text: 'Ana Sayfa', href: getPermalink('/') },
  ...(groupCrumb ? [groupCrumb] : []),
  { text: page.title },
];

const siteSettings = getSiteSettings();
const siteUrl = siteSettings?.url || SITE?.site;
const serviceSchema =
  page.group === 'hizmet'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Service',
        name: page.title,
        description: page.seoDescription ?? page.heroSubtitle ?? undefined,
        url: String(getCanonical(Astro.url.pathname)),
        serviceType: page.title,
        provider: { '@type': 'Organization', '@id': `${siteUrl}/#organization` },
        areaServed: 'TR',
      }
    : undefined;
---

<Layout metadata={metadata}>
  {serviceSchema && <StructuredData slot="head" schema={serviceSchema} />}
  <Breadcrumbs bar hideCurrent={page.group === 'hizmet'} items={breadcrumbItems} />
  <HeroText
    tagline={page.tagline ?? undefined}
    title={page.heroTitle ?? page.title}
    subtitle={page.heroSubtitle ?? undefined}
  />

  {
    page.features && page.features.length > 0 && (
      <Features tagline="Hizmet Kapsamı" title="Neleri Kapsar?" columns={2} items={page.features} />
    )
  }

  {
    page.approachItems && page.approachItems.length > 0 && (
      <Content
        tagline={page.approachTagline ?? undefined}
        title={page.approachTitle ?? undefined}
        items={page.approachItems}
        image={page.image ? { src: page.image, alt: page.imageAlt ?? page.title } : undefined}
      />
    )
  }

  {
    sections.length > 0 ? (
      <WidgetWrapper containerClass="max-w-4xl mx-auto">
        <Headline
          tagline="Detaylı Bakış"
          title={introTitle || undefined}
          classes={{ container: 'max-w-2xl', title: 'text-3xl md:text-4xl' }}
        />
        {introHtml && (
          <div
            class="prose prose-lg dark:prose-invert max-w-2xl mx-auto text-center mb-12 md:mb-16"
            set:html={introHtml}
          />
        )}
        <div class="max-w-3xl mx-auto">
          {sections.map(({ title, html, items }, index) => (
            <div class="flex gap-5 md:gap-6">
              <div class="flex flex-col items-center shrink-0">
                <div class="flex h-11 w-11 md:h-12 md:w-12 items-center justify-center rounded-full border-2 border-primary/30 bg-primary/5 font-heading font-bold text-primary dark:border-blue-700/60 dark:bg-blue-900/20 dark:text-blue-300">
                  {String(index + 1).padStart(2, '0')}
                </div>
                {index !== sections.length - 1 && <div class="w-px flex-1 bg-primary/15 dark:bg-blue-800/40 my-1" />}
              </div>
              <div class={index !== sections.length - 1 ? 'pb-10' : 'pb-1'}>
                <h3 class="text-xl md:text-2xl font-bold font-heading text-heading mb-2" set:html={title} />
                <div class="prose prose-lg dark:prose-invert max-w-none" set:html={html} />
                {items.length > 0 && (
                  <div class="mt-5 divide-y divide-gray-200 rounded-xl border border-gray-200 dark:divide-slate-700 dark:border-slate-700">
                    {items.map((item) => (
                      <div class="p-5">
                        <h4 class="font-bold text-heading mb-1.5" set:html={item.title} />
                        <div
                          class="prose prose-sm dark:prose-invert max-w-none text-muted"
                          set:html={item.description}
                        />
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </WidgetWrapper>
    ) : (
      introHtml && (
        <WidgetWrapper containerClass="max-w-3xl mx-auto">
          <Headline
            tagline="Detaylı Bakış"
            title={introTitle || undefined}
            classes={{ container: 'max-w-2xl', title: 'text-3xl md:text-4xl' }}
          />
          <div class="rounded-2xl border border-gray-200 bg-gray-50/60 px-6 py-8 dark:border-slate-700 dark:bg-slate-800/40 md:px-10 md:py-10">
            <div
              class="prose prose-lg dark:prose-invert max-w-none [&>p:first-of-type]:text-xl [&>p:first-of-type]:font-medium [&>p:first-of-type]:text-heading [&>p:first-of-type]:leading-relaxed"
              set:html={introHtml}
            />
          </div>
        </WidgetWrapper>
      )
    )
  }

  <CallToAction
    actions={[{ variant: 'primary', text: 'Teklif Talep Edin', href: '/iletisim#teklif', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">{page.ctaTitle}</Fragment>
    <Fragment slot="subtitle">{page.ctaSubtitle}</Fragment>
  </CallToAction>
</Layout>
