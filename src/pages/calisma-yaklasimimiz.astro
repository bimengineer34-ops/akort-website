---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Çalışma Yaklaşımımız',
  description: 'Analizden teslime, AKORT Mühendislik projelerini yöneten altı adımlı kontrollü mühendislik süreci.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Çalışma Yaklaşımımız"
    title="Tasarımdan uygulamaya, kontrollü bir süreç."
    subtitle="Her proje aynı altı adımdan geçer: analiz, tasarım, koordinasyon, optimizasyon, uygulama ve teslim. Bu düzen, disiplinler arası kararların tutarlılığını baştan sona korur."
  />

  <Steps
    tagline="Süreç"
    title="Kontrollü Mühendislik Süreci"
    items={[
      {
        title: '01 — <span class="font-medium">Analiz</span>',
        description:
          'Proje kriterlerini, saha verilerini ve teknik gereklilikleri; işveren ile birlikte netleştirerek başlarız.',
        icon: 'tabler:search',
      },
      {
        title: '02 — <span class="font-medium">Tasarım</span>',
        description: 'Disiplin bazlı mühendislik hesaplarını ve çözüm alternatiflerini geliştiririz.',
        icon: 'tabler:ruler-2',
      },
      {
        title: '03 — <span class="font-medium">Koordinasyon</span>',
        description: 'Tüm disiplinleri BIM modeli ve düzenli proje kontrol toplantılarıyla senkronize ederiz.',
        icon: 'tabler:arrows-join-2',
      },
      {
        title: '04 — <span class="font-medium">Optimizasyon</span>',
        description: 'Maliyet, enerji tüketimi ve uygulanabilirlik açısından sistemleri karşılaştırıp iyileştiririz.',
        icon: 'tabler:adjustments-horizontal',
      },
      {
        title: '05 — <span class="font-medium">Uygulama</span>',
        description: 'Saha süreçlerini teknik şartname ve proje kriterleri doğrultusunda kontrol altında yürütürüz.',
        icon: 'tabler:tool',
      },
      {
        title: '06 — <span class="font-medium">Teslim</span>',
        description: 'Test, devreye alma, kontrol, as-built belgeleme ve teslim adımlarını tamamlarız.',
        icon: 'tabler:circle-check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&q=85',
      alt: 'Mühendislik proje ve saha uygulama süreci',
    }}
  />

  <Content
    isAfterContent
    tagline="Neden Bu Sıra?"
    title="Her adım, bir sonrakinin doğruluğunu güvence altına alır."
    items={[
      {
        title: 'Erken Tespit',
        description: 'Koordinasyon aşamasında yakalanan bir çakışma, sahada onlarca kat daha maliyetli olabilir.',
      },
      {
        title: 'Geri Dönüşü Az Kararlar',
        description: 'Optimizasyon adımı, uygulamaya geçmeden önce sistem seçimlerini bir kez daha sınamamızı sağlar.',
      },
      {
        title: 'İzlenebilir Süreç',
        description: 'Proje kontrolü, tasarım kararlarının sahada da aynı şekilde korunduğunu teyit eder.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=1600&q=85',
      alt: 'Mühendislik ekibi proje kontrolü yapıyor',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Süreç, disiplindir.</h3>
      Aynı altı adımı her projede uygulamak, ölçeğe bakılmaksızın tutarlı bir mühendislik kalitesi sağlar.
    </Fragment>
  </Content>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Projenizi Konuşalım', href: '/iletisim', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">Sürecimizi projenizde görmek ister misiniz?</Fragment>
    <Fragment slot="subtitle">İhtiyacınızı birlikte değerlendirelim ve doğru mühendislik çözümünü oluşturalım.</Fragment
    >
  </CallToAction>
</Layout>
