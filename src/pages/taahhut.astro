---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Taahhüt & Uygulama',
  description: 'Projelerin sahada doğru, kontrollü ve mühendislik esaslarına uygun uygulanması.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Hizmetler / Taahhüt & Uygulama"
    title="Taahhüt & Uygulama"
    subtitle="Tasarımda alınan mühendislik kararlarını; saha organizasyonu, kalite kontrolü ve doğru koordinasyonla sahaya taşıyoruz."
  />

  <Features
    tagline="Hizmet Kapsamı"
    title="Neleri Kapsar?"
    columns={2}
    items={[
      {
        title: 'Saha Organizasyonu',
        description: 'İş programı, kaynak planlaması ve saha ekip koordinasyonu.',
        icon: 'tabler:sitemap',
      },
      {
        title: 'Kalite ve İş Güvenliği Kontrolü',
        description: 'Uygulamanın kalite standartları ve iş güvenliği kurallarına uygunluğunun denetimi.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Alt Yüklenici Koordinasyonu',
        description: 'Farklı disiplinlerdeki alt yüklenicilerin iş programına uygun yönetimi.',
        icon: 'tabler:network',
      },
      {
        title: 'Test & Devreye Alma',
        description: 'Mekanik ve elektrik sistemlerinin testi ile devreye alma süreçlerinin yönetimi.',
        icon: 'tabler:circle-check',
      },
      {
        title: 'As-Built Belgeleme',
        description: 'Uygulama sonrası güncel proje ve teknik dokümantasyonun hazırlanması.',
        icon: 'tabler:file-description',
      },
      {
        title: 'Teslim Süreçleri',
        description: 'Projenin işverene eksiksiz ve belgeli biçimde teslim edilmesi.',
        icon: 'tabler:clipboard-check',
      },
    ]}
  />

  <Content
    isReversed
    tagline="Yaklaşımımız"
    title="Tasarımı sahada da aynı bütünlükle sürdürmek."
    items={[
      {
        title: 'Mühendislik Esaslı Uygulama',
        description: 'Saha kararlarını da mühendislik hesap ve standartlarına dayandırırız.',
      },
      {
        title: 'Sürekli Koordinasyon',
        description: 'Tasarım ekibi ile saha ekibi arasındaki bilgi akışını kesintisiz tutarız.',
      },
      {
        title: 'Belgeli Teslim',
        description: 'Her teslim, test kayıtları ve as-built dokümantasyonuyla birlikte tamamlanır.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1600&q=85',
      alt: 'Taahhüt ve saha uygulama süreçleri',
    }}
  />

  <Features2
    tagline="İlgili Hizmetler"
    columns={2}
    items={[
      {
        title: 'Proje Kontrol',
        description: 'Uygulama sürecinin tasarımla tutarlılığının denetimi.',
        icon: 'tabler:clipboard-check',
        href: '/proje-kontrol',
      },
      {
        title: 'Teknik Danışmanlık',
        description: 'Saha sürecinde karşılaşılan teknik sorulara uzman desteği.',
        icon: 'tabler:bulb',
        href: '/teknik-danismanlik',
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Teklif Talep Edin', href: '/iletisim#teklif', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">Uygulama sürecinizi konuşalım.</Fragment>
    <Fragment slot="subtitle">İhtiyacınızı birlikte değerlendirelim ve doğru mühendislik çözümünü oluşturalım.</Fragment
    >
  </CallToAction>
</Layout>
