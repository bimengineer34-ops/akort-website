---
import { asc } from 'drizzle-orm';
import { db } from '~/db/client';
import { galleryItems } from '~/db/schema';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Gallery from '~/components/widgets/Gallery.astro';

export const prerender = false;

const items = db.select().from(galleryItems).orderBy(asc(galleryItems.sortOrder)).all();

const metadata = {
  title: 'Galeri',
  description: 'AKORT Mühendislik proje ve saha görsellerinden bir seçki.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Galeri" title="Sahadan ve Projelerden Kareler" />

  <Gallery
    columns={3}
    lightbox
    images={items.map((item) => ({ src: item.image, alt: item.caption ?? '', caption: item.caption ?? undefined }))}
  />
</Layout>
