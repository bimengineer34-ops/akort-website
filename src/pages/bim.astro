---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'BIM & Dijital Mühendislik',
  description: 'BIM modelleme, MEP koordinasyonu, clash detection, shop drawing, metraj ve dijital proje iş akışları.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Hizmetler / BIM & Dijital Mühendislik"
    title="Mühendisliği Dijitalleştiriyoruz."
    subtitle="Projeyi sahaya gelmeden önce görüyor, koordine ediyor ve optimize ediyoruz. BIM, disiplinler arası kararların aynı doğrulukla ilerlemesini sağlar."
  />

  <Features
    tagline="Hizmet Kapsamı"
    title="Neleri Kapsar?"
    columns={2}
    items={[
      {
        title: 'BIM Modelleme',
        description: 'Mimari, mekanik ve elektrik sistemlerinin koordineli ve veriye dayalı modellenmesi.',
        icon: 'tabler:cube-3d-sphere',
      },
      {
        title: 'MEP Coordination',
        description: 'Mekanik, elektrik ve sıhhi tesisat disiplinlerinin dijital ortamda senkronizasyonu.',
        icon: 'tabler:network',
      },
      {
        title: 'Clash Detection',
        description: 'Disiplin çakışmalarının uygulama öncesinde tespit edilmesi ve çözülmesi.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: 'Shop Drawing & As-Built BIM',
        description: 'Saha uygulamasına yönelik imalat çizimleri ve uygulama sonrası güncel modeller.',
        icon: 'tabler:file-description',
      },
      {
        title: 'Metraj & Model Kontrolü',
        description: 'Model tabanlı metraj çıkarımı ve teknik proje kontrolü.',
        icon: 'tabler:file-check',
      },
      {
        title: 'Dijital İş Akışları',
        description: 'Proje verilerinin tüm paydaşlar arasında tutarlı biçimde yönetilmesi.',
        icon: 'tabler:sitemap',
      },
    ]}
  />

  <Content
    isReversed
    tagline="Neden BIM?"
    title="Hatayı sahada değil, ekranda bulmak."
    items={[
      {
        title: 'Erken Çakışma Tespiti',
        description: 'Disiplinler arası çakışmaları, inşaat başlamadan modelde tespit ederiz.',
      },
      {
        title: 'Doğru Metraj',
        description: 'Model üzerinden çıkarılan metrajlar, keşif ve hakediş süreçlerini hızlandırır.',
      },
      {
        title: 'Tek Doğru Kaynak',
        description: 'Tüm disiplinler aynı güncel modele erişerek tutarsızlıkların önüne geçer.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1565008447742-97f6f38c985c?auto=format&fit=crop&w=1600&q=85',
      alt: 'BIM modelleme ve dijital mühendislik çalışma ortamı',
    }}
  />

  <Features2
    tagline="İlgili Hizmetler"
    columns={2}
    items={[
      {
        title: 'Proje Kontrol',
        description: 'Model ve saha arasındaki tutarlılığın sürekli denetimi.',
        icon: 'tabler:clipboard-check',
        href: '/proje-kontrol',
      },
      {
        title: 'Mekanik Mühendislik',
        description: 'MEP koordinasyonunun temelini oluşturan mekanik tasarım.',
        icon: 'tabler:wind',
        href: '/mekanik-muhendislik',
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Teklif Talep Edin', href: '/iletisim#teklif', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">Projenizi BIM ile koordine edelim.</Fragment>
    <Fragment slot="subtitle">İhtiyacınızı birlikte değerlendirelim ve doğru mühendislik çözümünü oluşturalım.</Fragment
    >
  </CallToAction>
</Layout>
