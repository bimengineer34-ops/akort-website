---
import { eq } from 'drizzle-orm';
import { db } from '~/db/client';
import { pages } from '~/db/schema';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

export const prerender = false;

const services = db.select().from(pages).where(eq(pages.group, 'hizmet')).all();

const metadata = {
  title: 'Hizmetlerimiz',
  description:
    'AKORT Mühendislik hizmetleri: mekanik, elektrik, BIM, enerji, GES, mimari, yapı, çelik, teknik danışmanlık, proje kontrol ve taahhüt & uygulama.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Hizmetlerimiz"
    title="Bütünleşik Mühendislik Hizmetleri"
    subtitle="Projelerinizi tek bir disiplin üzerinden değil; mimari, yapı, mekanik, elektrik, enerji ve dijital mühendislik bileşenlerini birlikte değerlendirerek ele alıyoruz."
  />

  <Features2
    columns={3}
    items={services.map((s) => ({
      title: s.title,
      description: s.heroSubtitle ?? '',
      icon: s.features?.[0]?.icon ?? 'tabler:tool',
      href: `/${s.slug}`,
    }))}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Teklif Talep Edin', href: '/iletisim#teklif', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">Hangi hizmete ihtiyacınız var?</Fragment>
    <Fragment slot="subtitle">Projenizi anlatın, size en uygun disiplin kombinasyonunu birlikte belirleyelim.</Fragment>
  </CallToAction>
</Layout>
