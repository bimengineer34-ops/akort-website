---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Çelik Yapılar',
  description: 'Çelik konstrüksiyon tasarımı, detaylandırılması, imalat koordinasyonu ve montaj denetimi.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Hizmetler / Çelik Yapılar"
    title="Çelik Yapılar"
    subtitle="Çelik konstrüksiyon projelerini; statik doğruluk, imalat kolaylığı ve montaj güvenliğini birlikte gözeterek tasarlıyoruz."
  />

  <Features
    tagline="Hizmet Kapsamı"
    title="Neleri Kapsar?"
    columns={2}
    items={[
      {
        title: 'Çelik Konstrüksiyon Tasarımı',
        description: 'Endüstriyel ve büyük açıklıklı yapılar için çelik taşıyıcı sistem tasarımı.',
        icon: 'tabler:building-warehouse',
      },
      {
        title: 'Statik & Dinamik Analiz',
        description: 'Rüzgar, deprem ve işletme yükleri altında yapısal davranışın analizi.',
        icon: 'tabler:gauge',
      },
      {
        title: 'Bağlantı Detaylandırma',
        description: 'Kaynaklı ve bulonlu bağlantı detaylarının imalata uygun hazırlanması.',
        icon: 'tabler:ruler-2',
      },
      {
        title: 'Shop Drawing',
        description: 'İmalat atölyesi için ölçekli ve detaylı üretim çizimleri.',
        icon: 'tabler:file-description',
      },
      {
        title: 'İmalat Koordinasyonu',
        description: 'Tasarım ile atölye üretim süreci arasındaki teknik uyumun sağlanması.',
        icon: 'tabler:sitemap',
      },
      {
        title: 'Montaj Denetimi',
        description: 'Sahada montaj sürecinin proje ve güvenlik kriterlerine uygun yürütülmesi.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <Content
    tagline="Yaklaşımımız"
    title="Tasarımdan atölyeye, kesintisiz doğruluk."
    items={[
      {
        title: 'İmalata Uygun Tasarım',
        description: 'Detayları, atölyenin gerçek üretim kapasitesi ve yöntemleriyle uyumlu kurgularız.',
      },
      {
        title: 'Toleransları Öngörme',
        description: 'Montaj toleranslarını tasarım aşamasında hesaba katarak saha sürprizlerini azaltırız.',
      },
      {
        title: 'Güvenlik Odaklı Montaj',
        description: 'Montaj sırasını ve geçici stabiliteyi proje aşamasında planlarız.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1600&q=85',
      alt: 'Çelik konstrüksiyon tasarım ve montaj süreci',
    }}
  />

  <Features2
    tagline="İlgili Hizmetler"
    columns={2}
    items={[
      {
        title: 'Yapı & İnşaat',
        description: 'Karma taşıyıcı sistem çözümlerinde koordineli çalışma.',
        icon: 'tabler:building-skyscraper',
        href: '/yapi-insaat',
      },
      {
        title: 'Proje Kontrol',
        description: 'İmalat ve montajın tasarımla tutarlılığının denetimi.',
        icon: 'tabler:clipboard-check',
        href: '/proje-kontrol',
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Teklif Talep Edin', href: '/iletisim#teklif', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">Çelik yapı projenizi konuşalım.</Fragment>
    <Fragment slot="subtitle">İhtiyacınızı birlikte değerlendirelim ve doğru mühendislik çözümünü oluşturalım.</Fragment
    >
  </CallToAction>
</Layout>
