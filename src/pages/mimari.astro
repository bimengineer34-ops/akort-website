---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Mimari',
  description: 'Konsept tasarımdan uygulama projesine, disiplinlerle koordineli mimari mühendislik çözümleri.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Hizmetler / Mimari"
    title="Mimari"
    subtitle="Mimari kararları; yapı, mekanik, elektrik ve enerji disiplinleriyle birlikte kurgulayarak, tasarımın sahada da doğru çalışmasını sağlıyoruz."
  />

  <Features
    tagline="Hizmet Kapsamı"
    title="Neleri Kapsar?"
    columns={2}
    items={[
      {
        title: 'Konsept Tasarım',
        description: 'Proje ihtiyaçlarına uygun mekansal kurgu ve ön tasarım alternatifleri.',
        icon: 'tabler:template',
      },
      {
        title: 'Avan & Uygulama Projeleri',
        description: 'Ruhsat ve uygulama aşamalarına yönelik detaylı mimari çizimler.',
        icon: 'tabler:building-arch',
      },
      {
        title: 'Disiplinler Arası Koordinasyon',
        description: 'Mimari kararların mekanik, elektrik ve yapı ile uyumlu ilerlemesi.',
        icon: 'tabler:network',
      },
      {
        title: 'Cephe ve Malzeme Detaylandırma',
        description: 'Performans ve estetik dengesini gözeten cephe ve malzeme çözümleri.',
        icon: 'tabler:layout',
      },
      {
        title: 'Ruhsat Süreç Desteği',
        description: 'İmar ve ruhsat süreçlerinde gerekli teknik dokümantasyonun hazırlanması.',
        icon: 'tabler:file-check',
      },
      {
        title: 'Sürdürülebilir Tasarım',
        description: 'Enerji performansını gözeten, çevresel etkisi düşük tasarım kararları.',
        icon: 'tabler:leaf',
      },
    ]}
  />

  <Content
    tagline="Yaklaşımımız"
    title="Mimari, tek başına bir disiplin değildir."
    items={[
      {
        title: 'Erken Koordinasyon',
        description: 'Mekanik ve elektrik gereksinimlerini tasarımın en başından itibaren dikkate alırız.',
      },
      {
        title: 'Uygulanabilir Detay',
        description: 'Cephe ve malzeme kararlarını, imalat ve montaj gerçekliğiyle birlikte değerlendiririz.',
      },
      {
        title: 'Enerji Bilinci',
        description: 'Yapı kabuğu kararlarının enerji performansına etkisini tasarım aşamasında hesaba katarız.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1600&q=85',
      alt: 'Mimari tasarım ve disiplinler arası koordinasyon',
    }}
  />

  <Features2
    tagline="İlgili Hizmetler"
    columns={2}
    items={[
      {
        title: 'Yapı & İnşaat',
        description: 'Taşıyıcı sistem ve yapısal detaylandırma ile uyumlu ilerleme.',
        icon: 'tabler:building-skyscraper',
        href: '/yapi-insaat',
      },
      {
        title: 'Çelik Yapılar',
        description: 'Çelik konstrüksiyon gerektiren mimari çözümler.',
        icon: 'tabler:building-warehouse',
        href: '/celik-yapilar',
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Teklif Talep Edin', href: '/iletisim#teklif', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">Mimari projenizi konuşalım.</Fragment>
    <Fragment slot="subtitle">İhtiyacınızı birlikte değerlendirelim ve doğru mühendislik çözümünü oluşturalım.</Fragment
    >
  </CallToAction>
</Layout>
