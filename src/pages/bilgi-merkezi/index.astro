---
import { desc, eq, and, or, like, count } from 'drizzle-orm';
import { db } from '~/db/client';
import { posts } from '~/db/schema';
import { toPost } from '~/lib/toPost';
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';

export const prerender = false;

const PAGE_SIZE = 9;
const currentPage = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1') || 1);
const q = (Astro.url.searchParams.get('q') ?? '').trim();

const whereClause = q
  ? and(
      eq(posts.draft, false),
      or(like(posts.title, `%${q}%`), like(posts.excerpt, `%${q}%`), like(posts.body, `%${q}%`))
    )
  : eq(posts.draft, false);

const total = db.select({ c: count() }).from(posts).where(whereClause).get()?.c ?? 0;
const rows = db
  .select()
  .from(posts)
  .where(whereClause)
  .orderBy(desc(posts.publishDate))
  .limit(PAGE_SIZE)
  .offset((currentPage - 1) * PAGE_SIZE)
  .all();

const postList = rows.map(toPost);
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

const pageUrl = (page: number) => `/bilgi-merkezi?${new URLSearchParams({ ...(q && { q }), page: String(page) })}`;

const breadcrumbs = [
  { text: 'Ana Sayfa', href: getPermalink('/') },
  ...(currentPage > 1
    ? [{ text: 'Bilgi Merkezi', href: '/bilgi-merkezi' }, { text: `Sayfa ${currentPage}` }]
    : [{ text: 'Bilgi Merkezi' }]),
];

const metadata = {
  title: `Bilgi Merkezi${currentPage > 1 ? ` — Sayfa ${currentPage}` : ''}`,
  description:
    'AKORT Mühendislik Bilgi Merkezi: mekanik, elektrik, BIM, enerji, GES ve yapı mühendisliği üzerine teknik makaleler ve mühendislik notları.',
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={breadcrumbs} />
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      subtitle="Mekanik, elektrik, BIM, enerji, GES ve yapı mühendisliği üzerine teknik makaleler ve mühendislik notları."
    >
      Bilgi Merkezi
    </Headline>

    <form method="GET" action="/bilgi-merkezi" class="mx-auto mb-10 max-w-xl">
      <div class="relative">
        <Icon
          name="tabler:search"
          class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-muted"
        />
        <input
          type="text"
          name="q"
          value={q}
          placeholder="Tüm yazılarda ara..."
          class="w-full rounded-full border border-gray-300 bg-white py-3 pl-12 pr-24 text-default placeholder:text-muted focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary dark:border-slate-700 dark:bg-slate-800"
        />
        <button
          type="submit"
          class="absolute right-1.5 top-1/2 -translate-y-1/2 rounded-full bg-primary px-4 py-1.5 text-sm font-medium text-white hover:opacity-90"
        >
          Ara
        </button>
      </div>
    </form>

    {
      q && (
        <p class="mb-8 text-center text-muted">
          {total > 0 ? `"${q}" için ${total} sonuç bulundu.` : `"${q}" için sonuç bulunamadı.`}{' '}
          <a href="/bilgi-merkezi" class="font-medium text-primary hover:underline">
            Aramayı temizle
          </a>
        </p>
      )
    }

    <BlogList posts={postList} />
    <Pagination
      prevUrl={currentPage > 1 ? pageUrl(currentPage - 1) : undefined}
      nextUrl={currentPage < totalPages ? pageUrl(currentPage + 1) : undefined}
    />
  </section>
</Layout>
