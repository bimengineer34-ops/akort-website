---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Proje Kontrol',
  description: 'Tasarım ile saha uygulaması arasındaki tutarlılığın sürekli denetimi, revizyon yönetimi ve raporlama.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Hizmetler / Proje Kontrol"
    title="Proje Kontrol"
    subtitle="Tasarımda alınan kararların, saha uygulamasında da aynı bütünlükle korunduğunu; süreç boyunca sürekli kontrol ederek güvence altına alıyoruz."
  />

  <Features
    tagline="Hizmet Kapsamı"
    title="Neleri Kapsar?"
    columns={2}
    items={[
      {
        title: 'Tasarım-Saha Tutarlılık Kontrolü',
        description: 'Uygulamanın onaylı projeye uygun ilerlediğinin düzenli denetimi.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'Revizyon Yönetimi',
        description: 'Proje değişikliklerinin kayıt altına alınması ve ilgili taraflara doğru iletilmesi.',
        icon: 'tabler:history',
      },
      {
        title: 'Disiplinler Arası Çakışma Takibi',
        description: 'Sahada ortaya çıkabilecek disiplin çakışmalarının erken tespiti.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: 'Şartname Uygunluk Denetimi',
        description: 'Uygulanan malzeme ve yöntemlerin teknik şartnameye uygunluğunun kontrolü.',
        icon: 'tabler:checklist',
      },
      {
        title: 'Metraj & Hakediş Kontrolü',
        description: 'İmalat miktarlarının ve hakediş taleplerinin projeyle karşılaştırılması.',
        icon: 'tabler:calculator',
      },
      {
        title: 'Raporlama',
        description: 'Süreç durumunun düzenli, anlaşılır raporlarla paydaşlara aktarılması.',
        icon: 'tabler:file-description',
      },
    ]}
  />

  <Content
    tagline="Yaklaşımımız"
    title="Kontrol, sürecin sonunda değil içinde olmalı."
    items={[
      {
        title: 'Düzenli Saha Ziyaretleri',
        description: 'Uygulamayı belirli aralıklarla yerinde inceleyerek sapmaları erken yakalarız.',
      },
      { title: 'Net İletişim', description: 'Bulguları, sorumlu taraflarla doğrudan ve zaman kaybetmeden paylaşırız.' },
      { title: 'İzlenebilir Kayıt', description: 'Her kontrol adımını belgeleyerek proje geçmişini şeffaf tutarız.' },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1565008447742-97f6f38c985c?auto=format&fit=crop&w=1600&q=85',
      alt: 'Proje kontrol ve saha denetim süreci',
    }}
  />

  <Features2
    tagline="İlgili Hizmetler"
    columns={2}
    items={[
      {
        title: 'BIM & Dijital Mühendislik',
        description: 'Model tabanlı kontrol ve çakışma takibi.',
        icon: 'tabler:cube-3d-sphere',
        href: '/bim',
      },
      {
        title: 'Teknik Danışmanlık',
        description: 'Bağımsız ikinci göz değerlendirmesi.',
        icon: 'tabler:bulb',
        href: '/teknik-danismanlik',
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Teklif Talep Edin', href: '/iletisim#teklif', icon: 'tabler:arrow-right' }]}
  >
    <Fragment slot="title">Projenizin kontrol sürecini konuşalım.</Fragment>
    <Fragment slot="subtitle">İhtiyacınızı birlikte değerlendirelim ve doğru mühendislik çözümünü oluşturalım.</Fragment
    >
  </CallToAction>
</Layout>
