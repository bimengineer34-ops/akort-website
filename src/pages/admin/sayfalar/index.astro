---
import { eq } from 'drizzle-orm';
import { db } from '~/db/client';
import { pages } from '~/db/schema';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';

export const prerender = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id'));
  if (String(form.get('_action')) === 'delete') {
    db.delete(pages).where(eq(pages.id, id)).run();
  }
  return Astro.redirect('/admin/sayfalar');
}

const rows = db.select().from(pages).all();
const groupLabel: Record<string, string> = { kurumsal: 'Kurumsal', hizmet: 'Hizmet', diger: 'Diğer' };
---

<AdminLayout title="Sayfalar">
  <div class="mb-3 d-flex justify-content-end">
    <a href="/admin/sayfalar/yeni" class="btn btn-primary">+ Yeni Sayfa</a>
  </div>
  <div class="card">
    <div class="table-responsive">
      <table class="table card-table table-vcenter">
        <thead>
          <tr>
            <th>Başlık</th>
            <th>Adres (/slug)</th>
            <th>Grup</th>
            <th>İşlemler</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((p) => (
              <tr>
                <td>{p.title}</td>
                <td>
                  <code>/{p.slug}</code>
                </td>
                <td>{groupLabel[p.group] ?? p.group}</td>
                <td class="d-flex gap-1">
                  <a href={`/${p.slug}`} target="_blank" class="btn btn-sm btn-icon btn-outline-secondary">
                    <Icon name="tabler:external-link" class="w-4 h-4" />
                  </a>
                  <a href={`/admin/sayfalar/${p.id}`} class="btn btn-sm btn-icon btn-outline-primary">
                    <Icon name="tabler:pencil" class="w-4 h-4" />
                  </a>
                  <form
                    method="POST"
                    onsubmit="return confirm('Bu sayfayı silmek istediğinize emin misiniz? Site üzerinde bu adres 404 verecektir.')"
                  >
                    <input type="hidden" name="id" value={p.id} />
                    <input type="hidden" name="_action" value="delete" />
                    <button type="submit" class="btn btn-sm btn-icon btn-outline-danger">
                      <Icon name="tabler:trash" class="w-4 h-4" />
                    </button>
                  </form>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
