---
import { desc, eq } from 'drizzle-orm';
import { db } from '~/db/client';
import { posts } from '~/db/schema';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';

export const prerender = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id'));
  if (String(form.get('_action')) === 'delete') {
    db.delete(posts).where(eq(posts.id, id)).run();
  }
  return Astro.redirect('/admin/blog');
}

const rows = db.select().from(posts).orderBy(desc(posts.publishDate)).all();
---

<AdminLayout title="Blog Yönetimi">
  <div class="mb-3 d-flex justify-content-end">
    <a href="/admin/blog/yeni" class="btn btn-primary">+ Yeni Yazı</a>
  </div>
  <div class="card">
    <div class="table-responsive">
      <table class="table card-table table-vcenter">
        <thead>
          <tr>
            <th>Başlık</th>
            <th>Kategori</th>
            <th>Tarih</th>
            <th>Durum</th>
            <th>İşlemler</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.length === 0 ? (
              <tr>
                <td colspan="5" class="text-center text-muted py-4">
                  Henüz yazı yok.
                </td>
              </tr>
            ) : (
              rows.map((p) => (
                <tr>
                  <td>{p.title}</td>
                  <td>{p.category}</td>
                  <td>{new Date(p.publishDate).toLocaleDateString('tr-TR')}</td>
                  <td>
                    <span class:list={['badge', p.draft ? 'bg-secondary-lt' : 'bg-green-lt']}>
                      {p.draft ? 'Taslak' : 'Yayında'}
                    </span>
                  </td>
                  <td class="d-flex gap-1">
                    <a
                      href={`/bilgi-merkezi/${p.slug}`}
                      target="_blank"
                      class="btn btn-sm btn-icon btn-outline-secondary"
                    >
                      <Icon name="tabler:external-link" class="w-4 h-4" />
                    </a>
                    <a href={`/admin/blog/${p.id}`} class="btn btn-sm btn-icon btn-outline-primary">
                      <Icon name="tabler:pencil" class="w-4 h-4" />
                    </a>
                    <form method="POST" onsubmit="return confirm('Bu yazıyı silmek istediğinize emin misiniz?')">
                      <input type="hidden" name="id" value={p.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button type="submit" class="btn btn-sm btn-icon btn-outline-danger">
                        <Icon name="tabler:trash" class="w-4 h-4" />
                      </button>
                    </form>
                  </td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
