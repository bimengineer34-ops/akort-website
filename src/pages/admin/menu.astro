---
import { eq } from 'drizzle-orm';
import { db } from '~/db/client';
import { settings } from '~/db/schema';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';

export const prerender = false;

interface NavLink {
  text: string;
  href?: string;
  links?: NavLink[];
}
interface NavData {
  header: { links: NavLink[]; actions: Array<{ text: string; href: string }> };
  footer: {
    links: Array<{ title: string; links: Array<{ text: string; href: string }> }>;
    secondaryLinks: Array<{ text: string; href: string }>;
    socialLinks: Array<{ ariaLabel: string; icon: string; href: string }>;
    footNote: string;
  };
}

const EMPTY_NAV: NavData = {
  header: { links: [], actions: [] },
  footer: { links: [], secondaryLinks: [], socialLinks: [], footNote: '' },
};

let success = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const s = (v: unknown) => String(v ?? '').trim();

  // Header links: top-level rows (hl_*) each carry a stable hl_id; sub-menu
  // rows (hs_*) reference their parent via hs_parent. Reconstructed by
  // zipping the parallel arrays FormData gives us, same pattern already used
  // for repeatable rows elsewhere in the admin (feature/approach items).
  const hlId = form.getAll('hl_id').map(String);
  const hlText = form.getAll('hl_text').map(String);
  const hlHref = form.getAll('hl_href').map(String);
  const hsParent = form.getAll('hs_parent').map(String);
  const hsText = form.getAll('hs_text').map(String);
  const hsHref = form.getAll('hs_href').map(String);

  const headerLinks: NavLink[] = [];
  hlId.forEach((id, i) => {
    const text = hlText[i]?.trim() ?? '';
    if (!text) return;
    const subs = hsParent
      .map((p, j) => (p === id ? { text: hsText[j]?.trim() ?? '', href: hsHref[j]?.trim() ?? '' } : null))
      .filter((x): x is { text: string; href: string } => !!x && x.text !== '');
    const link: NavLink = subs.length > 0 ? { text, links: subs } : { text, href: (hlHref[i] ?? '').trim() };
    headerLinks.push(link);
  });

  const haText = form.getAll('ha_text').map(String);
  const haHref = form.getAll('ha_href').map(String);
  const headerActions = haText
    .map((t, i) => ({ text: t.trim(), href: (haHref[i] ?? '').trim() }))
    .filter((a) => a.text && a.href);

  const fcId = form.getAll('fc_id').map(String);
  const fcTitle = form.getAll('fc_title').map(String);
  const flParent = form.getAll('fl_parent').map(String);
  const flText = form.getAll('fl_text').map(String);
  const flHref = form.getAll('fl_href').map(String);

  const footerColumns: Array<{ title: string; links: Array<{ text: string; href: string }> }> = [];
  fcId.forEach((id, i) => {
    const title = fcTitle[i]?.trim() ?? '';
    if (!title) return;
    const links = flParent
      .map((p, j) => (p === id ? { text: flText[j]?.trim() ?? '', href: flHref[j]?.trim() ?? '' } : null))
      .filter((x): x is { text: string; href: string } => !!x && x.text !== '');
    footerColumns.push({ title, links });
  });

  const secText = form.getAll('sec_text').map(String);
  const secHref = form.getAll('sec_href').map(String);
  const secondaryLinks = secText
    .map((t, i) => ({ text: t.trim(), href: (secHref[i] ?? '').trim() }))
    .filter((l) => l.text && l.href);

  const socLabel = form.getAll('soc_label').map(String);
  const socIcon = form.getAll('soc_icon').map(String);
  const socHref = form.getAll('soc_href').map(String);
  const socialLinks = socLabel
    .map((label, i) => ({ ariaLabel: label.trim(), icon: (socIcon[i] ?? '').trim(), href: (socHref[i] ?? '').trim() }))
    .filter((x) => x.ariaLabel && x.icon && x.href);

  const value: NavData = {
    header: { links: headerLinks, actions: headerActions },
    footer: { links: footerColumns, secondaryLinks, socialLinks, footNote: s(form.get('footnote')) },
  };

  db.update(settings).set({ value }).where(eq(settings.key, 'navigation')).run();
  success = 'Menü güncellendi.';
}

const row = db.select().from(settings).where(eq(settings.key, 'navigation')).get();
const nav = (row?.value as NavData) ?? EMPTY_NAV;
---

<AdminLayout title="Menü Yönetimi">
  {success && <div class="alert alert-success">{success}</div>}

  <aw-menu-editor>
    <form method="POST">
      <!-- ============ HEADER MENU ============ -->
      <div class="card mb-3">
        <div class="card-header">
          <h3 class="card-title">Üst Menü</h3>
        </div>
        <div class="card-body" data-nested-repeater data-id-prefix="h">
          <div data-top-rows>
            {
              nav.header.links.map((link, i) => {
                const id = `h${i}`;
                return (
                  <div class="border rounded p-3 mb-3" data-top-row data-row data-row-id={id}>
                    <div class="row g-2 align-items-start">
                      <div class="col-md-4">
                        <label class="form-label small text-muted">Metin</label>
                        <input type="hidden" name="hl_id" data-id-field value={id} />
                        <input type="text" name="hl_text" class="form-control" value={link.text} />
                      </div>
                      <div class="col-md-6">
                        <label class="form-label small text-muted">
                          Bağlantı {link.links?.length ? '(alt menü varsa kullanılmaz)' : ''}
                        </label>
                        <input type="text" name="hl_href" class="form-control" value={link.href} />
                      </div>
                      <div class="col-md-2 d-flex align-items-end">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100" data-remove-row>
                          <Icon name="tabler:trash" class="w-4 h-4" /> Sil
                        </button>
                      </div>
                    </div>

                    <div class="mt-3 ps-3 border-start">
                      <div class="small text-muted mb-2">
                        Alt menü öğeleri (varsa, yukarıdaki bağlantı yerine bu liste açılır menü olarak gösterilir)
                      </div>
                      <div data-sub-rows>
                        {(link.links ?? []).map((sub) => (
                          <div class="row g-2 mb-2" data-row>
                            <input type="hidden" name="hs_parent" data-parent-field value={id} />
                            <div class="col-md-5">
                              <input
                                type="text"
                                name="hs_text"
                                class="form-control form-control-sm"
                                placeholder="Metin"
                                value={sub.text}
                              />
                            </div>
                            <div class="col-md-5">
                              <input
                                type="text"
                                name="hs_href"
                                class="form-control form-control-sm"
                                placeholder="Bağlantı"
                                value={sub.href}
                              />
                            </div>
                            <div class="col-md-2">
                              <button type="button" class="btn btn-outline-danger btn-sm w-100" data-remove-row>
                                <Icon name="tabler:x" class="w-4 h-4" />
                              </button>
                            </div>
                          </div>
                        ))}
                      </div>
                      <button type="button" class="btn btn-outline-secondary btn-sm mt-1" data-add-sub>
                        <Icon name="tabler:plus" class="w-4 h-4" /> Alt Menü Öğesi Ekle
                      </button>
                    </div>
                  </div>
                );
              })
            }
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm" data-add-top>
            <Icon name="tabler:plus" class="w-4 h-4" /> Üst Menü Öğesi Ekle
          </button>

          <template data-top-template>
            <div class="border rounded p-3 mb-3" data-top-row data-row>
              <div class="row g-2 align-items-start">
                <div class="col-md-4">
                  <label class="form-label small text-muted">Metin</label>
                  <input type="hidden" name="hl_id" data-id-field value="" />
                  <input type="text" name="hl_text" class="form-control" />
                </div>
                <div class="col-md-6">
                  <label class="form-label small text-muted">Bağlantı</label>
                  <input type="text" name="hl_href" class="form-control" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                  <button type="button" class="btn btn-outline-danger btn-sm w-100" data-remove-row>
                    <Icon name="tabler:trash" class="w-4 h-4" /> Sil
