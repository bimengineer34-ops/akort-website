              </div>
            </div>
          </template>
          <template data-sub-template>
            <div class="row g-2 mb-2" data-row>
              <input type="hidden" name="hs_parent" data-parent-field value="" />
              <div class="col-md-5">
                <input type="text" name="hs_text" class="form-control form-control-sm" placeholder="Metin" />
              </div>
