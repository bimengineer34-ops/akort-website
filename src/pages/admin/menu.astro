          </div>
          <button type="button" class="btn btn-outline-primary btn-sm" data-add-flat>
            <Icon name="tabler:plus" class="w-4 h-4" /> Bağlantı Ekle
          </button>
          <template>
            <div class="row g-2 mb-2" data-row>
              <div class="col-md-6">
                <input type="text" name="sec_text" class="form-control" placeholder="Metin" />
              </div>
              <div class="col-md-4">
                <input type="text" name="sec_href" class="form-control" placeholder="Bağlantı" />
              </div>
              <div class="col-md-2">
                <button type="button" class="btn btn-outline-danger btn-sm w-100" data-remove-row>
                  <Icon name="tabler:trash" class="w-4 h-4" />
                </button>
              </div>
            </div>
          </template>
        </div>
      </div>

      <!-- ============ SOCIAL LINKS ============ -->
      <div class="card mb-3">
        <div class="card-header">
          <h3 class="card-title">Sosyal Medya</h3>
          <div class="card-subtitle">
            İkon adı için <a href="https://tabler.io/icons" target="_blank">tabler.io/icons</a> kullanın (örn. tabler:brand-instagram).
          </div>
        </div>
        <div class="card-body" data-flat-repeater>
          <div data-rows>
            {
              nav.footer.socialLinks.map((s) => (
                <div class="row g-2 mb-2" data-row>
                  <div class="col-md-3">
                    <input
                      type="text"
                      name="soc_label"
                      class="form-control"
                      placeholder="Etiket (ör. Instagram)"
                      value={s.ariaLabel}
                    />
                  </div>
                  <div class="col-md-3">
                    <input
                      type="text"
                      name="soc_icon"
                      class="form-control"
                      placeholder="tabler:brand-instagram"
                      value={s.icon}
                    />
                  </div>
                  <div class="col-md-4">
                    <input type="text" name="soc_href" class="form-control" placeholder="Bağlantı" value={s.href} />
                  </div>
                  <div class="col-md-2">
                    <button type="button" class="btn btn-outline-danger btn-sm w-100" data-remove-row>
                      <Icon name="tabler:trash" class="w-4 h-4" />
                    </button>
                  </div>
                </div>
              ))
            }
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm" data-add-flat>
            <Icon name="tabler:plus" class="w-4 h-4" /> Sosyal Bağlantı Ekle
          </button>
          <template>
            <div class="row g-2 mb-2" data-row>
              <div class="col-md-3">
                <input type="text" name="soc_label" class="form-control" placeholder="Etiket (ör. Instagram)" />
              </div>
              <div class="col-md-3">
                <input type="text" name="soc_icon" class="form-control" placeholder="tabler:brand-instagram" />
              </div>
              <div class="col-md-4">
                <input type="text" name="soc_href" class="form-control" placeholder="Bağlantı" />
              </div>
              <div class="col-md-2">
                <button type="button" class="btn btn-outline-danger btn-sm w-100" data-remove-row>
                  <Icon name="tabler:trash" class="w-4 h-4" />
                </button>
              </div>
            </div>
          </template>
        </div>
      </div>

      <!-- ============ FOOTER NOTE ============ -->
      <div class="card mb-3">
        <div class="card-header">
          <h3 class="card-title">Footer Alt Not Metni</h3>
        </div>
        <div class="card-body">
          <input type="text" name="footnote" class="form-control" value={nav.footer.footNote} />
          <small class="text-muted"
            ><code>{'{year}'}</code> yazdığınız yer otomatik olarak güncel yıl ile değişir.</small
          >
        </div>
      </div>

      <button type="submit" class="btn btn-primary">Kaydet</button>
    </form>
  </aw-menu-editor>
</AdminLayout>

<script>
  class AwMenuEditor extends HTMLElement {
    connectedCallback() {
      let counter = 0;
      const uid = (prefix: string) => `${prefix}-${Date.now().toString(36)}-${(counter++).toString(36)}`;

      // Flat repeaters: a container with [data-rows], a hidden <template>, and
      // an "add" button — every row is independent, no nesting.
      this.querySelectorAll<HTMLElement>('[data-flat-repeater]').forEach((repeater) => {
        const template = repeater.querySelector('template');
        const rows = repeater.querySelector('[data-rows]');
        const addBtn = repeater.querySelector('[data-add-flat]');
        if (!template || !rows) return;
        addBtn?.addEventListener('click', () => {
          rows.appendChild(template.content.cloneNode(true));
        });
      });

      // Nested repeaters: header links (with dropdown sub-items) and footer
      // columns (with their own links) share the same shape — a top-level row
      // that owns a mini flat-repeater of sub-rows tagged with its id.
      this.querySelectorAll<HTMLElement>('[data-nested-repeater]').forEach((repeater) => {
        const idPrefix = repeater.dataset.idPrefix ?? 'x';
        const topTemplate = repeater.querySelector<HTMLTemplateElement>('template[data-top-template]');
        const subTemplate = repeater.querySelector<HTMLTemplateElement>('template[data-sub-template]');
        const topRows = repeater.querySelector('[data-top-rows]');
        const addTopBtn = repeater.querySelector('[data-add-top]');

        const wireRow = (row: HTMLElement) => {
          const addSubBtn = row.querySelector('[data-add-sub]');
          const subRows = row.querySelector('[data-sub-rows]');
          addSubBtn?.addEventListener('click', () => {
            if (!subTemplate || !subRows) return;
            const parentId = row.dataset.rowId ?? '';
            const frag = subTemplate.content.cloneNode(true) as DocumentFragment;
            frag.querySelectorAll<HTMLInputElement>('[data-parent-field]').forEach((el) => (el.value = parentId));
            subRows.appendChild(frag);
          });
        };

        repeater.querySelectorAll<HTMLElement>('[data-top-row]').forEach(wireRow);

        addTopBtn?.addEventListener('click', () => {
          if (!topTemplate || !topRows) return;
          const newId = uid(idPrefix);
          const frag = topTemplate.content.cloneNode(true) as DocumentFragment;
          const row = frag.querySelector<HTMLElement>('[data-top-row]');
          if (!row) return;
          row.dataset.rowId = newId;
          frag.querySelectorAll<HTMLInputElement>('[data-id-field]').forEach((el) => (el.value = newId));
          topRows.appendChild(frag);
          wireRow(row);
        });
      });

      // Remove: delegated so it works on both server-rendered and cloned rows.
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest<HTMLElement>('[data-remove-row]');
        if (btn) {
          e.preventDefault();
          btn.closest<HTMLElement>('[data-row]')?.remove();
        }
      });
    }
  }
  if (!customElements.get('aw-menu-editor')) customElements.define('aw-menu-editor', AwMenuEditor);
</script>
