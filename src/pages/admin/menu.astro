                <button type="button" class="btn btn-outline-secondary btn-sm mt-1" data-add-sub>
                  <Icon name="tabler:plus" class="w-4 h-4" /> Bağlantı Ekle
                </button>
              </div>
            </div>
          </template>
          <template data-sub-template>
            <div class="row g-2 mb-2" data-row>
              <input type="hidden" name="fl_parent" data-parent-field value="" />
              <div class="col-md-5">
                <input type="text" name="fl_text" class="form-control form-control-sm" placeholder="Metin" />
              </div>
              <div class="col-md-5">
                <input type="text" name="fl_href" class="form-control form-control-sm" placeholder="Bağlantı" />
              </div>
              <div class="col-md-2">
                <button type="button" class="btn btn-outline-danger btn-sm w-100" data-remove-row>
                  <Icon name="tabler:x" class="w-4 h-4" />
                </button>
              </div>
            </div>
          </template>
        </div>
      </div>

      <!-- ============ LEGAL LINKS ============ -->
      <div class="card mb-3">
        <div class="card-header">
          <h3 class="card-title">Alt Yasal Bağlantılar</h3>
          <div class="card-subtitle">Footer'ın en altında (KVKK, Gizlilik Politikası vb.)</div>
        </div>
        <div class="card-body" data-flat-repeater>
          <div data-rows>
            {
              nav.footer.secondaryLinks.map((l) => (
                <div class="row g-2 mb-2" data-row>
                  <div class="col-md-6">
                    <input type="text" name="sec_text" class="form-control" placeholder="Metin" value={l.text} />
                  </div>
                  <div class="col-md-4">
                    <input type="text" name="sec_href" class="form-control" placeholder="Bağlantı" value={l.href} />
                  </div>
                  <div class="col-md-2">
                    <button type="button" class="btn btn-outline-danger btn-sm w-100" data-remove-row>
                      <Icon name="tabler:trash" class="w-4 h-4" />
