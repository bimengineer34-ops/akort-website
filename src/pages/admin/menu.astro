                                name="fl_href"
                                class="form-control form-control-sm"
                                placeholder="Bağlantı"
                                value={l.href}
                              />
                            </div>
                            <div class="col-md-2">
                              <button type="button" class="btn btn-outline-danger btn-sm w-100" data-remove-row>
                                <Icon name="tabler:x" class="w-4 h-4" />
                              </button>
                            </div>
                          </div>
                        ))}
                      </div>
                      <button type="button" class="btn btn-outline-secondary btn-sm mt-1" data-add-sub>
                        <Icon name="tabler:plus" class="w-4 h-4" /> Bağlantı Ekle
                      </button>
                    </div>
                  </div>
                );
              })
            }
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm" data-add-top>
            <Icon name="tabler:plus" class="w-4 h-4" /> Sütun Ekle
          </button>

          <template data-top-template>
            <div class="border rounded p-3 mb-3" data-top-row data-row>
              <div class="row g-2">
                <div class="col-md-8">
                  <label class="form-label small text-muted">Sütun Başlığı</label>
                  <input type="hidden" name="fc_id" data-id-field value="" />
                  <input type="text" name="fc_title" class="form-control" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                  <button type="button" class="btn btn-outline-danger btn-sm w-100" data-remove-row>
                    <Icon name="tabler:trash" class="w-4 h-4" /> Sütunu Sil
