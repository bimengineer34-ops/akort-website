                      </div>
                    </div>
                    <div class="mt-3 ps-3 border-start">
                      <div class="small text-muted mb-2">Bağlantılar</div>
                      <div data-sub-rows>
                        {col.links.map((l) => (
                          <div class="row g-2 mb-2" data-row>
                            <input type="hidden" name="fl_parent" data-parent-field value={id} />
                            <div class="col-md-5">
                              <input
                                type="text"
                                name="fl_text"
                                class="form-control form-control-sm"
                                placeholder="Metin"
                                value={l.text}
                              />
                            </div>
                            <div class="col-md-5">
                              <input
