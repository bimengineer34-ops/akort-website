---
import { count, eq, desc, gte, sql } from 'drizzle-orm';
import { db } from '~/db/client';
import { messages, posts, projects, galleryItems, pages, users, pageViews } from '~/db/schema';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';

export const prerender = false;

const c = (n: number) => n;
const postCount = c(db.select({ n: count() }).from(posts).get()?.n ?? 0);
const projectCount = c(db.select({ n: count() }).from(projects).get()?.n ?? 0);
const galleryCount = c(db.select({ n: count() }).from(galleryItems).get()?.n ?? 0);
const pageCount = c(db.select({ n: count() }).from(pages).get()?.n ?? 0);
const userCount = c(db.select({ n: count() }).from(users).get()?.n ?? 0);
const unreadCount = c(db.select({ n: count() }).from(messages).where(eq(messages.status, 'yeni')).get()?.n ?? 0);

const recentMessages = db.select().from(messages).orderBy(desc(messages.createdAt)).limit(5).all();

// Site's own visit counts (src/lib/analytics.ts, logged per request in
// middleware.ts) — no external account or API key needed to see them here.
const startOfDay = new Date();
startOfDay.setHours(0, 0, 0, 0);
const startOfWeek = new Date(startOfDay);
startOfWeek.setDate(startOfWeek.getDate() - 6);
const startOfMonth = new Date(startOfDay);
startOfMonth.setDate(startOfMonth.getDate() - 29);

const viewsToday = c(
  db.select({ n: count() }).from(pageViews).where(gte(pageViews.createdAt, startOfDay)).get()?.n ?? 0
);
const viewsThisWeek = c(
  db.select({ n: count() }).from(pageViews).where(gte(pageViews.createdAt, startOfWeek)).get()?.n ?? 0
);
const viewsThisMonth = c(
  db.select({ n: count() }).from(pageViews).where(gte(pageViews.createdAt, startOfMonth)).get()?.n ?? 0
);

const viewCount = count();
const topPages = db
  .select({ path: pageViews.path, n: viewCount })
  .from(pageViews)
  .where(gte(pageViews.createdAt, startOfMonth))
  .groupBy(pageViews.path)
  .orderBy(desc(viewCount))
  .limit(6)
  .all();

// Daily counts for the last 14 days, as a chart. SQLite's own date() reads
// the integer column as a unix-epoch-seconds timestamp (how Drizzle's
// `mode: 'timestamp'` stores it) and buckets by calendar day.
const dayBucket = sql<string>`date(${pageViews.createdAt}, 'unixepoch')`;
const startOfChart = new Date(startOfDay);
startOfChart.setDate(startOfChart.getDate() - 13);
const dailyRows = db
  .select({ day: dayBucket, n: count() })
  .from(pageViews)
  .where(gte(pageViews.createdAt, startOfChart))
  .groupBy(dayBucket)
  .all();
const dailyByDay = new Map(dailyRows.map((r) => [r.day, r.n]));
const chartDays: string[] = [];
const chartCounts: number[] = [];
for (let i = 13; i >= 0; i--) {
  const d = new Date(startOfDay);
  d.setDate(d.getDate() - i);
  const key = d.toISOString().slice(0, 10);
  chartDays.push(d.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short' }));
  chartCounts.push(dailyByDay.get(key) ?? 0);
}

const cards = [
  { label: 'İletişim Mesajları', value: unreadCount, sub: 'okunmamış', icon: 'tabler:mail', color: 'bg-red-lt' },
  { label: 'Blog Yazısı', value: postCount, sub: 'toplam', icon: 'tabler:article', color: 'bg-blue-lt' },
  { label: 'Proje', value: projectCount, sub: 'toplam', icon: 'tabler:briefcase', color: 'bg-green-lt' },
  { label: 'Galeri Öğesi', value: galleryCount, sub: 'toplam', icon: 'tabler:photo', color: 'bg-yellow-lt' },
  { label: 'Sayfa', value: pageCount, sub: 'toplam', icon: 'tabler:file-text', color: 'bg-purple-lt' },
  { label: 'Kullanıcı', value: userCount, sub: 'toplam', icon: 'tabler:users', color: 'bg-cyan-lt' },
];
---

<AdminLayout title="Dashboard">
  <div class="alert alert-info" role="alert">
    <strong>Hoş Geldiniz!</strong> Yönetim paneline hoş geldiniz. Sol menüden yapmak istediğiniz işlemi seçebilirsiniz.
  </div>

  <div class="row row-deck row-cards mb-3">
    {
      cards.map((card) => (
        <div class="col-sm-6 col-lg-4">
          <div class="card">
            <div class="card-body d-flex align-items-center gap-3">
              <span class={`avatar ${card.color}`}>
                <Icon name={card.icon} class="w-6 h-6" />
              </span>
              <div>
                <div class="h1 mb-0">{card.value}</div>
                <div class="text-muted">
                  {card.label} <span class="text-muted small">({card.sub})</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="card mb-3">
    <div class="card-header">
      <h3 class="card-title">Ziyaret İstatistikleri</h3>
      <div class="card-subtitle">Sitenin kendi ziyaret sayacı — kimlik/IP kaydetmez, sadece sayfa ve zaman.</div>
    </div>
    <div class="card-body">
      <div class="row mb-4">
        <div class="col-4 text-center">
          <div class="h1 mb-0">{viewsToday}</div>
          <div class="text-muted">Bugün</div>
        </div>
        <div class="col-4 text-center">
          <div class="h1 mb-0">{viewsThisWeek}</div>
          <div class="text-muted">Son 7 Gün</div>
        </div>
        <div class="col-4 text-center">
          <div class="h1 mb-0">{viewsThisMonth}</div>
          <div class="text-muted">Son 30 Gün</div>
        </div>
      </div>

      {
        topPages.length > 0 ? (
          <div class="row">
            <div class="col-lg-7 mb-4 mb-lg-0">
              <h4 class="mb-2">Son 14 Gün</h4>
              <div style="height: 220px; position: relative">
                <canvas id="dailyViewsChart" />
              </div>
            </div>
            <div class="col-lg-5">
              <h4 class="mb-2">En Çok Görüntülenen Sayfalar</h4>
              <div style="height: 220px; position: relative">
                <canvas id="topPagesChart" />
              </div>
            </div>
          </div>
        ) : (
          <p class="text-muted mb-0">Henüz ziyaret verisi yok.</p>
        )
      }

      {
        topPages.length > 0 && (
          <table class="table table-sm card-table table-vcenter mt-4">
            <tbody>
              {topPages.map((p) => (
                <tr>
                  <td>
                    <a href={p.path} target="_blank" rel="noopener noreferrer">
                      {p.path}
                    </a>
                  </td>
                  <td class="text-end fw-bold">{p.n}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
    </div>
  </div>

  {
    topPages.length > 0 && (
      <script
        type="application/json"
        id="dashboard-chart-data"
        set:html={JSON.stringify({
          days: chartDays,
          counts: chartCounts,
          topLabels: topPages.map((p) => p.path),
          topCounts: topPages.map((p) => p.n),
        })}
      />
    )
  }
  <script>
    function initDashboardCharts() {
      const dataEl = document.getElementById('dashboard-chart-data');
      // @ts-expect-error Chart.js is loaded globally from the CDN script in AdminLayout.
      if (!dataEl || typeof Chart === 'undefined') return;
      const data = JSON.parse(dataEl.textContent || '{}');
      const accent = getComputedStyle(document.documentElement).getPropertyValue('--tblr-primary').trim() || '#206bc4';

      const lineCanvas = document.getElementById('dailyViewsChart');
      if (lineCanvas) {
        // @ts-expect-error see above
        new Chart(lineCanvas, {
          type: 'line',
          data: {
            labels: data.days,
            datasets: [
              {
                label: 'Ziyaret',
                data: data.counts,
                borderColor: accent,
                backgroundColor: accent + '22',
                fill: true,
                tension: 0.3,
                pointRadius: 2,
              },
            ],
          },
          options: {
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
          },
        });
      }

      const donutCanvas = document.getElementById('topPagesChart');
      if (donutCanvas) {
        // @ts-expect-error see above
        new Chart(donutCanvas, {
          type: 'doughnut',
          data: {
            labels: data.topLabels,
            datasets: [
              {
                data: data.topCounts,
                backgroundColor: ['#206bc4', '#4299e1', '#79a6dc', '#2fb344', '#f76707', '#ae3ec9'],
              },
            ],
          },
          options: {
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } } },
          },
        });
      }
    }
    // Chart.js loads via its own <script> at the end of AdminLayout's body;
    // as ES modules, scripts execute in document order, so it may not have
    // run yet at this point. Wait for the window load event to be sure.
    if (document.readyState === 'complete') {
      initDashboardCharts();
    } else {
      window.addEventListener('load', initDashboardCharts);
    }
  </script>

  <div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
      <h3 class="card-title">Son Mesajlar</h3>
      <a href="/admin/mesajlar" class="btn btn-sm btn-outline-primary">Tümünü Gör</a>
    </div>
    <div class="table-responsive">
      <table class="table card-table table-vcenter">
        <thead>
          <tr>
            <th>Ad Soyad</th>
            <th>E-posta</th>
            <th>Tür</th>
            <th>Durum</th>
            <th>Tarih</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            recentMessages.length === 0 ? (
              <tr>
                <td colspan="6" class="text-center text-muted py-4">
                  Henüz mesaj yok.
                </td>
              </tr>
            ) : (
              recentMessages.map((m) => (
                <tr>
                  <td>{m.name}</td>
                  <td>{m.email}</td>
                  <td>{m.type}</td>
                  <td>
                    <span class:list={['badge', m.status === 'yeni' ? 'bg-yellow-lt' : 'bg-green-lt']}>{m.status}</span>
                  </td>
                  <td>{new Date(m.createdAt).toLocaleString('tr-TR')}</td>
                  <td>
                    <a href={`/admin/mesajlar/${m.id}`} class="btn btn-sm btn-icon btn-outline-primary">
                      <Icon name="tabler:eye" class="w-4 h-4" />
                    </a>
                  </td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
