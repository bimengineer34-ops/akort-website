---
import { count, eq, desc, gte } from 'drizzle-orm';
import { db } from '~/db/client';
import { messages, posts, projects, galleryItems, pages, users, pageViews } from '~/db/schema';
import AdminLayout from '~/layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';

export const prerender = false;

const c = (n: number) => n;
const postCount = c(db.select({ n: count() }).from(posts).get()?.n ?? 0);
const projectCount = c(db.select({ n: count() }).from(projects).get()?.n ?? 0);
const galleryCount = c(db.select({ n: count() }).from(galleryItems).get()?.n ?? 0);
const pageCount = c(db.select({ n: count() }).from(pages).get()?.n ?? 0);
const userCount = c(db.select({ n: count() }).from(users).get()?.n ?? 0);
const unreadCount = c(db.select({ n: count() }).from(messages).where(eq(messages.status, 'yeni')).get()?.n ?? 0);

const recentMessages = db.select().from(messages).orderBy(desc(messages.createdAt)).limit(5).all();

// Site's own visit counts (src/lib/analytics.ts, logged per request in
// middleware.ts) — no external account or API key needed to see them here.
const startOfDay = new Date();
startOfDay.setHours(0, 0, 0, 0);
const startOfWeek = new Date(startOfDay);
startOfWeek.setDate(startOfWeek.getDate() - 6);
const startOfMonth = new Date(startOfDay);
startOfMonth.setDate(startOfMonth.getDate() - 29);

const viewsToday = c(
  db.select({ n: count() }).from(pageViews).where(gte(pageViews.createdAt, startOfDay)).get()?.n ?? 0
);
const viewsThisWeek = c(
  db.select({ n: count() }).from(pageViews).where(gte(pageViews.createdAt, startOfWeek)).get()?.n ?? 0
);
const viewsThisMonth = c(
  db.select({ n: count() }).from(pageViews).where(gte(pageViews.createdAt, startOfMonth)).get()?.n ?? 0
);

const viewCount = count();
const topPages = db
  .select({ path: pageViews.path, n: viewCount })
  .from(pageViews)
  .where(gte(pageViews.createdAt, startOfMonth))
  .groupBy(pageViews.path)
  .orderBy(desc(viewCount))
  .limit(6)
  .all();

const cards = [
  { label: 'İletişim Mesajları', value: unreadCount, sub: 'okunmamış', icon: 'tabler:mail', color: 'bg-red-lt' },
  { label: 'Blog Yazısı', value: postCount, sub: 'toplam', icon: 'tabler:article', color: 'bg-blue-lt' },
  { label: 'Proje', value: projectCount, sub: 'toplam', icon: 'tabler:briefcase', color: 'bg-green-lt' },
  { label: 'Galeri Öğesi', value: galleryCount, sub: 'toplam', icon: 'tabler:photo', color: 'bg-yellow-lt' },
  { label: 'Sayfa', value: pageCount, sub: 'toplam', icon: 'tabler:file-text', color: 'bg-purple-lt' },
  { label: 'Kullanıcı', value: userCount, sub: 'toplam', icon: 'tabler:users', color: 'bg-cyan-lt' },
];
---

<AdminLayout title="Dashboard">
  <div class="alert alert-info" role="alert">
    <strong>Hoş Geldiniz!</strong> Yönetim paneline hoş geldiniz. Sol menüden yapmak istediğiniz işlemi seçebilirsiniz.
  </div>

  <div class="row row-deck row-cards mb-3">
    {
      cards.map((card) => (
        <div class="col-sm-6 col-lg-4">
          <div class="card">
            <div class="card-body d-flex align-items-center gap-3">
              <span class={`avatar ${card.color}`}>
                <Icon name={card.icon} class="w-6 h-6" />
              </span>
              <div>
                <div class="h1 mb-0">{card.value}</div>
                <div class="text-muted">
                  {card.label} <span class="text-muted small">({card.sub})</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="card mb-3">
    <div class="card-header">
      <h3 class="card-title">Ziyaret İstatistikleri</h3>
      <div class="card-subtitle">Sitenin kendi ziyaret sayacı — kimlik/IP kaydetmez, sadece sayfa ve zaman.</div>
    </div>
    <div class="card-body">
      <div class="row mb-4">
        <div class="col-4 text-center">
          <div class="h1 mb-0">{viewsToday}</div>
          <div class="text-muted">Bugün</div>
        </div>
        <div class="col-4 text-center">
          <div class="h1 mb-0">{viewsThisWeek}</div>
          <div class="text-muted">Son 7 Gün</div>
        </div>
        <div class="col-4 text-center">
          <div class="h1 mb-0">{viewsThisMonth}</div>
          <div class="text-muted">Son 30 Gün</div>
        </div>
      </div>
      {
        topPages.length > 0 ? (
          <>
            <h4 class="mb-2">En Çok Görüntülenen Sayfalar (son 30 gün)</h4>
            <table class="table table-sm card-table table-vcenter">
              <tbody>
                {topPages.map((p) => (
                  <tr>
                    <td>
                      <a href={p.path} target="_blank" rel="noopener noreferrer">
                        {p.path}
                      </a>
                    </td>
                    <td class="text-end fw-bold">{p.n}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        ) : (
          <p class="text-muted mb-0">Henüz ziyaret verisi yok.</p>
        )
      }
    </div>
  </div>

  <div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
      <h3 class="card-title">Son Mesajlar</h3>
      <a href="/admin/mesajlar" class="btn btn-sm btn-outline-primary">Tümünü Gör</a>
    </div>
    <div class="table-responsive">
      <table class="table card-table table-vcenter">
        <thead>
          <tr>
            <th>Ad Soyad</th>
            <th>E-posta</th>
            <th>Tür</th>
            <th>Durum</th>
            <th>Tarih</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            recentMessages.length === 0 ? (
              <tr>
                <td colspan="6" class="text-center text-muted py-4">
                  Henüz mesaj yok.
                </td>
              </tr>
            ) : (
              recentMessages.map((m) => (
                <tr>
                  <td>{m.name}</td>
                  <td>{m.email}</td>
                  <td>{m.type}</td>
                  <td>
                    <span class:list={['badge', m.status === 'yeni' ? 'bg-yellow-lt' : 'bg-green-lt']}>{m.status}</span>
                  </td>
                  <td>{new Date(m.createdAt).toLocaleString('tr-TR')}</td>
                  <td>
                    <a href={`/admin/mesajlar/${m.id}`} class="btn btn-sm btn-icon btn-outline-primary">
                      <Icon name="tabler:eye" class="w-4 h-4" />
                    </a>
                  </td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
